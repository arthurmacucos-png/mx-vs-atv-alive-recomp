 }
 
+// mx_alive fix: k_16 / k_16_16_16_16 resolve destinations with the signed
+// repeating fraction number format must be packed as SNORM, not UNORM.
+// Packing them as UNORM dropped negative values and flipped the sign of values
+// above 0.5 once fetched as signed, which made water/terrain simulations that
+// feed back through such resolves blow up into spikes.
+uint2_xe XePackR16G16B16A16SNorm(float4_xe f) {
+  f = min(max(f, float_x4_xe(-1.0f)), float_x4_xe(1.0f)) * 32767.0f;
+  int4_xe n = int4_xe(sign(f) * floor(abs(f) + 0.5f));
+  uint4_xe u = uint4_xe(n) & 0xFFFFu;
+  return u.rb | (u.ga << 16);
+}
+
 uint2_xe XePack16bpp4PixelsInUInt2(float4_xe pixel_0, float4_xe pixel_1,
                                    float4_xe pixel_2, float4_xe pixel_3,
                                    uint format) {
