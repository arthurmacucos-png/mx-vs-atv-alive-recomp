+#include <ws2tcpip.h>  // NOLINT(build/include_order)
+
+REXCVAR_DEFINE_STRING(net_mode, "off", "Net",
+                      "Online relay: off, host (you are the server) or join");
+REXCVAR_DEFINE_STRING(net_host, "", "Net", "Host IP or name to join (net_mode=join)");
