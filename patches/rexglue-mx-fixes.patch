+namespace rex::kernel::xam::netrelay {
+
+namespace {
+
+enum : uint8_t {
+  T_HELLO = 1,
+  T_WELCOME = 2,
+  T_DATA = 3,
+  T_SESSION = 4,
+  T_PING = 5,
+  T_BYE = 6,
+};
+constexpr uint32_t kMagic = 0x3152584D;  // "MXR1"
+constexpr uint32_t kHostVip = kVipNet | 1;
+constexpr size_t kMaxPacket = 1500;
+
+using Clock = std::chrono::steady_clock;
+
+struct Peer {
+  sockaddr_in addr{};
+  Clock::time_point last_seen;
+  std::string name;
+};
+
+struct State {
+  std::once_flag once;
+  std::atomic<bool> running{false};
+  bool host = false;
+  SOCKET relay = INVALID_SOCKET;
+  sockaddr_in host_addr{};
+  std::atomic<uint32_t> vip{0};
+  uint64_t xuid = 0;
+  std::string name;
+
+  std::mutex mutex;  // everything below
+  std::map<uint32_t, Peer> peers;  // host only, by vip
+  uint32_t next_vip = 2;
+  // injectors: key = vip<<16 | port  ->  loopback socket
+  std::map<uint64_t, SOCKET> injectors;
+  std::map<uint16_t, uint64_t> injector_by_port;
+  std::map<uint64_t, uint16_t> local_port_cache;  // native socket -> port
+
+  bool has_session = false;
+  uint8_t session[60] = {};
+  uint32_t pub_slots = 0, priv_slots = 0, filled = 0;
+  std::vector<uint8_t> qos;
+  bool session_dirty = false;
+};
+
+State& S() {
+  static State s;
+  return s;
+}
+
+void Put32(std::vector<uint8_t>& v, uint32_t x) {
+  for (int i = 0; i < 4; i++) v.push_back(uint8_t(x >> (i * 8)));
+}
+void Put16(std::vector<uint8_t>& v, uint16_t x) {
+  v.push_back(uint8_t(x));
+  v.push_back(uint8_t(x >> 8));
+}
+uint32_t Get32(const uint8_t* p) {
+  return uint32_t(p[0]) | uint32_t(p[1]) << 8 | uint32_t(p[2]) << 16 | uint32_t(p[3]) << 24;
+}
+uint16_t Get16(const uint8_t* p) {
+  return uint16_t(p[0] | p[1] << 8);
+}
+
+std::vector<uint8_t> Header(uint8_t type) {
+  std::vector<uint8_t> v;
+  Put32(v, kMagic);
+  v.push_back(type);
+  return v;
+}
+
+void SendRaw(const sockaddr_in& to, const std::vector<uint8_t>& v) {
+  sendto(S().relay, reinterpret_cast<const char*>(v.data()), int(v.size()), 0,
+         reinterpret_cast<const sockaddr*>(&to), sizeof(to));
+}
+
+std::string AddrStr(const sockaddr_in& a) {
+  char buf[64];
+  inet_ntop(AF_INET, &a.sin_addr, buf, sizeof(buf));
+  return std::string(buf) + ":" + std::to_string(ntohs(a.sin_port));
+}
+
+std::string VipStr(uint32_t vip) {
+  return std::to_string(vip >> 24) + "." + std::to_string((vip >> 16) & 255) + "." +
+         std::to_string((vip >> 8) & 255) + "." + std::to_string(vip & 255);
+}
+
+// Delivers a payload to the local game: send it on loopback from the injector
+// that represents (src_vip, src_port). Caller holds no lock.
+void Inject(uint32_t src_vip, uint16_t src_port, uint16_t dst_port, const uint8_t* data,
+            size_t len) {
+  auto& s = S();
+  SOCKET inj;
+  {
+    std::lock_guard<std::mutex> lock(s.mutex);
+    uint64_t key = uint64_t(src_vip) << 16 | src_port;
+    auto it = s.injectors.find(key);
+    if (it == s.injectors.end()) {
+      inj = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+      if (inj == INVALID_SOCKET) return;
+      sockaddr_in a{};
+      a.sin_family = AF_INET;
+      a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+      a.sin_port = 0;
+      bind(inj, reinterpret_cast<sockaddr*>(&a), sizeof(a));
+      int alen = sizeof(a);
+      getsockname(inj, reinterpret_cast<sockaddr*>(&a), &alen);
+      s.injectors[key] = inj;
+      s.injector_by_port[ntohs(a.sin_port)] = key;
+    } else {
+      inj = it->second;
+    }
+  }
+  sockaddr_in to{};
+  to.sin_family = AF_INET;
+  to.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  to.sin_port = htons(dst_port);
+  sendto(inj, reinterpret_cast<const char*>(data), int(len), 0,
+         reinterpret_cast<sockaddr*>(&to), sizeof(to));
+}
+
+std::vector<uint8_t> DataPacket(uint32_t src_vip, uint16_t src_port, uint32_t dst_vip,
+                                uint16_t dst_port, const uint8_t* data, size_t len) {
+  auto v = Header(T_DATA);
+  Put32(v, src_vip);
+  Put16(v, src_port);
+  Put32(v, dst_vip);
+  Put16(v, dst_port);
+  v.insert(v.end(), data, data + len);
+  return v;
+}
+
+// Host: route one datagram from src_vip (already authenticated).
+void HostRoute(uint32_t src_vip, uint16_t src_port, uint32_t dst_vip, uint16_t dst_port,
+               const uint8_t* data, size_t len) {
+  auto& s = S();
+  auto pkt = DataPacket(src_vip, src_port, dst_vip, dst_port, data, len);
+  if (IsBroadcast(dst_vip)) {
+    std::vector<sockaddr_in> targets;
+    {
+      std::lock_guard<std::mutex> lock(s.mutex);
+      for (auto& p : s.peers)
+        if (p.first != src_vip) targets.push_back(p.second.addr);
+    }
+    for (auto& t : targets) SendRaw(t, pkt);
+    if (src_vip != kHostVip) Inject(src_vip, src_port, dst_port, data, len);
+  } else if (dst_vip == kHostVip) {
+    Inject(src_vip, src_port, dst_port, data, len);
+  } else {
+    sockaddr_in to;
+    {
+      std::lock_guard<std::mutex> lock(s.mutex);
+      auto it = s.peers.find(dst_vip);
+      if (it == s.peers.end()) return;
+      to = it->second.addr;
+    }
+    SendRaw(to, pkt);
+  }
+}
+
+std::vector<uint8_t> SessionPacket() {
+  auto& s = S();
+  auto v = Header(T_SESSION);
+  std::lock_guard<std::mutex> lock(s.mutex);
+  v.push_back(s.has_session ? 1 : 0);
+  v.insert(v.end(), s.session, s.session + 60);
+  Put32(v, s.pub_slots);
+  Put32(v, s.priv_slots);
+  Put32(v, uint32_t(s.peers.size() + 1));
+  Put16(v, uint16_t(s.qos.size()));
+  v.insert(v.end(), s.qos.begin(), s.qos.end());
+  return v;
+}
+
+void HostHandle(const sockaddr_in& from, const uint8_t* p, size_t n) {
+  auto& s = S();
+  uint8_t type = p[4];
+  const uint8_t* b = p + 5;
+  size_t bn = n - 5;
+  // Find the sender.
+  uint32_t vip = 0;
+  {
+    std::lock_guard<std::mutex> lock(s.mutex);
+    for (auto& pe : s.peers) {
+      if (pe.second.addr.sin_addr.s_addr == from.sin_addr.s_addr &&
+          pe.second.addr.sin_port == from.sin_port) {
+        vip = pe.first;
+        pe.second.last_seen = Clock::now();
+        break;
+      }
+    }
+  }
+  if (type == T_HELLO) {
+    std::string name(reinterpret_cast<const char*>(b), strnlen(reinterpret_cast<const char*>(b),
+                                                              bn < 32 ? bn : 32));
+    bool fresh = false;
+    if (!vip) {
+      std::lock_guard<std::mutex> lock(s.mutex);
+      if (s.next_vip >= 250) return;
+      vip = kVipNet | s.next_vip++;
+      Peer pe;
+      pe.addr = from;
+      pe.last_seen = Clock::now();
+      pe.name = name;
+      s.peers[vip] = pe;
+      fresh = true;
+    }
+    auto w = Header(T_WELCOME);
+    Put32(w, vip);
+    SendRaw(from, w);
+    SendRaw(from, SessionPacket());
+    if (fresh)
+      REXKRNL_INFO("[net] {} entrou ({} -> {})", name, AddrStr(from), VipStr(vip));
+    return;
+  }
+  if (!vip) return;  // unknown sender
+  if (type == T_DATA && bn >= 12) {
+    uint16_t src_port = Get16(b + 4);
+    uint32_t dst_vip = Get32(b + 6);
+    uint16_t dst_port = Get16(b + 10);
+    HostRoute(vip, src_port, dst_vip, dst_port, b + 12, bn - 12);
+  } else if (type == T_BYE) {
+    std::lock_guard<std::mutex> lock(s.mutex);
+    REXKRNL_INFO("[net] {} saiu", VipStr(vip));
+    s.peers.erase(vip);
+  }
+}
+
+void ClientHandle(const sockaddr_in& from, const uint8_t* p, size_t n) {
+  auto& s = S();
+  if (from.sin_addr.s_addr != s.host_addr.sin_addr.s_addr ||
+      from.sin_port != s.host_addr.sin_port)
+    return;
+  uint8_t type = p[4];
+  const uint8_t* b = p + 5;
+  size_t bn = n - 5;
+  if (type == T_WELCOME && bn >= 4) {
+    uint32_t v = Get32(b);
+    if (s.vip.exchange(v) != v)
+      REXKRNL_INFO("[net] conectado ao host {} como {}", AddrStr(from), VipStr(v));
+  } else if (type == T_DATA && bn >= 12) {
+    Inject(Get32(b), Get16(b + 4), Get16(b + 10), b + 12, bn - 12);
+  } else if (type == T_SESSION && bn >= 1 + 60 + 12 + 2) {
+    std::lock_guard<std::mutex> lock(s.mutex);
+    s.has_session = b[0] != 0;
+    std::memcpy(s.session, b + 1, 60);
+    s.pub_slots = Get32(b + 61);
+    s.priv_slots = Get32(b + 65);
+    s.filled = Get32(b + 69);
+    uint16_t ql = Get16(b + 73);
+    if (bn >= size_t(75 + ql)) s.qos.assign(b + 75, b + 75 + ql);
+  }
+}
+
+void Loop() {
+  auto& s = S();
+  std::vector<uint8_t> buf(65536);
+  auto last_tick = Clock::now() - std::chrono::seconds(5);
+  while (s.running) {
+    fd_set rf;
+    FD_ZERO(&rf);
+    FD_SET(s.relay, &rf);
+    timeval tv{0, 200000};
+    if (select(0, &rf, nullptr, nullptr, &tv) > 0) {
+      sockaddr_in from{};
+      int flen = sizeof(from);
+      int n = recvfrom(s.relay, reinterpret_cast<char*>(buf.data()), int(buf.size()), 0,
+                       reinterpret_cast<sockaddr*>(&from), &flen);
+      if (n >= 5 && Get32(buf.data()) == kMagic) {
+        if (s.host)
+          HostHandle(from, buf.data(), size_t(n));
+        else
+          ClientHandle(from, buf.data(), size_t(n));
+      }
+    }
+    auto now = Clock::now();
+    if (now - last_tick < std::chrono::seconds(1)) continue;
+    last_tick = now;
+    if (s.host) {
+      std::vector<sockaddr_in> targets;
+      {
+        std::lock_guard<std::mutex> lock(s.mutex);
+        for (auto it = s.peers.begin(); it != s.peers.end();) {
+          if (now - it->second.last_seen > std::chrono::seconds(20)) {
+            REXKRNL_INFO("[net] {} caiu (sem resposta)", it->second.name);
+            it = s.peers.erase(it);
+          } else {
+            targets.push_back(it->second.addr);
+            ++it;
+          }
+        }
+      }
+      auto sp = SessionPacket();
+      for (auto& t : targets) SendRaw(t, sp);
+    } else {
+      if (!s.vip) {
+        auto h = Header(T_HELLO);
+        char name[32] = {};
+        std::strncpy(name, s.name.c_str(), sizeof(name) - 1);
+        h.insert(h.end(), name, name + 32);
+        SendRaw(s.host_addr, h);
+      } else {
+        // Keep-alive; HELLO again is harmless and refreshes the session.
+        auto h = Header(T_HELLO);
+        char name[32] = {};
+        std::strncpy(name, s.name.c_str(), sizeof(name) - 1);
+        h.insert(h.end(), name, name + 32);
+        SendRaw(s.host_addr, h);
+      }
+    }
+  }
+}
+
+uint64_t MakeXuid(const std::string& name) {
+  std::random_device rd;
+  uint64_t r = (uint64_t(rd()) << 32) ^ rd();
+  uint64_t h = 1469598103934665603ull;
+  for (char c : name) h = (h ^ uint8_t(c)) * 1099511628211ull;
+  // Online XUIDs live in 0x0009xxxxxxxxxxxx.
+  return 0x0009000000000000ull | ((h ^ r) & 0x0000FFFFFFFFFFFFull);
+}
+
+void Start() {
+  auto& s = S();
+  rex_trace_exports = REXCVAR_GET(log_exports);
+  if (REXCVAR_GET(scan_missing_functions)) rex_scan_missing_functions();
+  std::string mode = REXCVAR_GET(net_mode);
+  if (mode != "host" && mode != "join") return;
+  WSADATA wsa;
+  WSAStartup(MAKEWORD(2, 2), &wsa);
+
+  s.host = mode == "host";
+  s.name = REXCVAR_GET(net_name);
+  if (s.name.empty()) {
+    char user[64] = {};
+    DWORD ul = sizeof(user);
+    if (GetEnvironmentVariableA("USERNAME", user, ul)) s.name = user;
+    if (s.name.empty()) s.name = "Piloto";
+  }
+  if (s.name.size() > 15) s.name.resize(15);
+  s.xuid = MakeXuid(s.name);
+  uint16_t port = uint16_t(REXCVAR_GET(net_port));
+
+  s.relay = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+  sockaddr_in a{};
+  a.sin_family = AF_INET;
+  a.sin_addr.s_addr = htonl(INADDR_ANY);
+  a.sin_port = s.host ? htons(port) : 0;
+  if (bind(s.relay, reinterpret_cast<sockaddr*>(&a), sizeof(a)) != 0) {
+    REXKRNL_ERROR("[net] não consegui abrir a porta UDP {} (já está em uso?)", port);
+    closesocket(s.relay);
+    s.relay = INVALID_SOCKET;
+    return;
+  }
+  if (s.host) {
+    s.vip = kHostVip;
+    REXKRNL_INFO("[net] HOST: você é o servidor. Porta UDP {} ({})", port, s.name);
+  } else {
+    std::string host = REXCVAR_GET(net_host);
+    addrinfo hints{}, *res = nullptr;
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_DGRAM;
+    if (host.empty() || getaddrinfo(host.c_str(), nullptr, &hints, &res) != 0 || !res) {
+      REXKRNL_ERROR("[net] endereço do host inválido: '{}'", host);
+      closesocket(s.relay);
+      s.relay = INVALID_SOCKET;
+      return;
+    }
+    s.host_addr = *reinterpret_cast<sockaddr_in*>(res->ai_addr);
+    s.host_addr.sin_port = htons(port);
+    freeaddrinfo(res);
+    REXKRNL_INFO("[net] JOIN: conectando em {} ({})", AddrStr(s.host_addr), s.name);
+  }
+  s.running = true;
+  std::thread(Loop).detach();
+  if (!s.host) {
+    // Give the handshake a moment so the first XNet calls see an address.
+    for (int i = 0; i < 30 && !s.vip; i++) std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    if (!s.vip) REXKRNL_WARN("[net] host ainda não respondeu; seguindo e tentando em segundo plano");
+  }
+}
+
+uint16_t LocalPort(uint64_t native_socket) {
+  auto& s = S();
+  {
+    std::lock_guard<std::mutex> lock(s.mutex);
+    auto it = s.local_port_cache.find(native_socket);
+    if (it != s.local_port_cache.end() && it->second) return it->second;
+  }
+  sockaddr_in a{};
+  int alen = sizeof(a);
+  if (getsockname(SOCKET(native_socket), reinterpret_cast<sockaddr*>(&a), &alen) != 0) return 0;
+  uint16_t p = ntohs(a.sin_port);
+  std::lock_guard<std::mutex> lock(s.mutex);
+  s.local_port_cache[native_socket] = p;
+  return p;
+}
+
+}  // namespace
+
+void EnsureStarted() {
+  std::call_once(S().once, Start);
+}
+
+bool Active() {
+  EnsureStarted();
+  return S().running;
+}
+bool IsHost() {
+  return Active() && S().host;
+}
+uint32_t LocalVip() {
+  return Active() ? S().vip.load() : 0;
+}
+uint64_t LocalXuid() {
+  return S().xuid;
+}
+std::string LocalName() {
+  return S().name;
+}
+
+bool IsBroadcast(uint32_t ip) {
+  return ip == 0xFFFFFFFF || ip == (kVipNet | 0xFFFF) || (IsVirtual(ip) && (ip & 0xFF) == 0xFF);
+}
+
+bool SendTo(uint64_t native_socket, uint32_t dst_ip, uint16_t dst_port, const uint8_t* data,
+            uint32_t len) {
+  if (!Active()) return false;
+  if (!IsVirtual(dst_ip) && !IsBroadcast(dst_ip)) return false;
+  auto& s = S();
+  uint32_t me = s.vip;
+  if (!me) return true;  // not connected yet: drop, like a cable not plugged in
+  uint32_t dst = IsBroadcast(dst_ip) ? 0xFFFFFFFF : dst_ip;
+  uint16_t sport = LocalPort(native_socket);
+  if (dst == me) {
+    Inject(me, sport, dst_port, data, len);
+    return true;
+  }
+  if (s.host) {
+    HostRoute(me, sport, dst, dst_port, data, len);
+  } else {
+    SendRaw(s.host_addr, DataPacket(me, sport, dst, dst_port, data, len));
+  }
+  return true;
+}
+
+bool TranslateFrom(uint32_t& ip, uint16_t& port) {
+  if (ip != INADDR_LOOPBACK || !S().running) return false;
+  auto& s = S();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  auto it = s.injector_by_port.find(port);
+  if (it == s.injector_by_port.end()) return false;
+  ip = uint32_t(it->second >> 16);
+  port = uint16_t(it->second & 0xFFFF);
+  return true;
+}
+
+void BuildXnAddr(uint32_t vip, uint8_t* x) {
+  std::memset(x, 0, 36);
+  uint32_t be = htonl(vip);
+  std::memcpy(x + 0, &be, 4);  // ina
+  std::memcpy(x + 4, &be, 4);  // inaOnline
+  uint16_t port = htons(uint16_t(REXCVAR_GET(net_port)));
+  std::memcpy(x + 8, &port, 2);
+  // abEnet: locally administered MAC carrying the vip.
+  x[10] = 0x02;
+  x[11] = 0x4D;
+  x[12] = uint8_t(vip >> 24);
+  x[13] = uint8_t(vip >> 16);
+  x[14] = uint8_t(vip >> 8);
+  x[15] = uint8_t(vip);
+  // abOnline: tag + vip so it is unique per player.
+  std::memcpy(x + 16, "MXR1", 4);
+  std::memcpy(x + 20, &be, 4);
+}
+
+uint32_t VipFromXnAddr(const uint8_t* x) {
+  uint32_t be;
+  std::memcpy(&be, x, 4);
+  uint32_t v = ntohl(be);
+  if (IsVirtual(v)) return v;
+  std::memcpy(&be, x + 4, 4);
+  v = ntohl(be);
+  return IsVirtual(v) ? v : 0;
+}
+
+void PublishSession(const uint8_t* info60, uint32_t pub, uint32_t priv) {
+  auto& s = S();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  s.has_session = true;
+  std::memcpy(s.session, info60, 60);
+  s.pub_slots = pub;
+  s.priv_slots = priv;
+}
+
+void ClearSession() {
+  auto& s = S();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  s.has_session = false;
+}
+
+bool GetSession(uint8_t* info60, uint32_t& pub, uint32_t& priv, uint32_t& filled) {
+  auto& s = S();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  if (!s.has_session) return false;
+  std::memcpy(info60, s.session, 60);
+  pub = s.pub_slots;
+  priv = s.priv_slots;
+  filled = s.host ? uint32_t(s.peers.size() + 1) : s.filled;
+  return true;
+}
+
+void SetQosData(const uint8_t* data, uint32_t len) {
+  auto& s = S();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  s.qos.assign(data, data + std::min<uint32_t>(len, 1024));
+}
+
+std::vector<uint8_t> GetQosData() {
+  auto& s = S();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  return s.qos;
+}
+
+}  // namespace rex::kernel::xam::netrelay
