+
+void D3D12CommandProcessor::TrimReadbackBuffers(
+    std::unordered_map<uint64_t, ReadbackBuffer>& buffer_map, uint64_t budget_bytes,
+    uint64_t protected_key) {
+  uint64_t total = 0;
+  for (const auto& kv : buffer_map) {
+    total += ReadbackBufferBytes(kv.second);
+  }
+  if (total <= budget_bytes) {
+    return;
+  }
+  // No queued copy may still reference a buffer that is about to be released.
+  readback_copy_worker_->WaitForIdle();
+  uint64_t freed = 0;
+  size_t freed_count = 0;
+  while (total > budget_bytes) {
+    auto oldest = buffer_map.end();
+    for (auto it = buffer_map.begin(); it != buffer_map.end(); ++it) {
+      // Never drop the one being written now or anything used this frame.
+      if (it->first == protected_key || it->second.last_used_frame >= frame_current_) {
+        continue;
+      }
+      if (oldest == buffer_map.end() || it->second.last_used_frame < oldest->second.last_used_frame) {
+        oldest = it;
+      }
+    }
+    if (oldest == buffer_map.end()) {
+      break;
+    }
+    uint64_t bytes = ReadbackBufferBytes(oldest->second);
+    ReleaseReadbackBuffer(oldest->second);
+    buffer_map.erase(oldest);
+    total -= bytes;
+    freed += bytes;
+    ++freed_count;
+  }
+  if (freed_count) {
+    REXGPU_DEBUG("Readback buffers trimmed: freed {} buffers ({} MB), {} MB still in use",
+                 freed_count, freed >> 20, total >> 20);
   }
 }
 
