+void D3D12CommandProcessor::ReadbackProbeHit(void* context, uint32_t physical_address,
+                                             uint32_t length) {
+  auto* self = static_cast<D3D12CommandProcessor*>(context);
+  std::lock_guard<std::mutex> probe_lock(self->readback_probe_mutex_);
+  for (auto& kv : self->readback_probe_states_) {
+    uint32_t target_address = uint32_t(kv.first >> 32);
+    uint32_t target_length = uint32_t(kv.first);
+    if (target_address < physical_address + length &&
+        physical_address < target_address + target_length) {
+      // The guest touches this target: keep copying it back from now on.
+      kv.second.cpu_read = true;
+      kv.second.armed = false;
+    }
+  }
+}
