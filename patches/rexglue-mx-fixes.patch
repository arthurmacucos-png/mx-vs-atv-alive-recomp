+/**
+ * MX Alive online relay.
+ *
+ * The player who opens the session is the server/relay. Everyone gets a
+ * virtual address 10.77.0.N (host = .1). The game's own network code (XNet,
+ * sockets, XSession) is not rewritten: the existing kernel exports are
+ * intercepted and their traffic is tunneled through one UDP port on the host.
+ *
+ * Packets for a guest socket are delivered by a real UDP send on loopback from
+ * an "injector" socket that stands for one remote (vip, port), so blocking
+ * recvfrom, select and non-blocking sockets all keep working unchanged; the
+ * loopback source is rewritten back to the virtual address on receive.
+ */
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace rex::kernel::xam::netrelay {
+
+constexpr uint32_t kVipNet = 0x0A4D0000;   // 10.77.0.0 (host order)
+constexpr uint32_t kVipMask = 0xFFFF0000;
+
+bool Active();       // net_mode is host or join and the relay is running
+bool IsHost();
+uint32_t LocalVip();  // host order, 0 until assigned
+uint64_t LocalXuid();
+std::string LocalName();
+
+inline bool IsVirtual(uint32_t ip_host_order) {
+  return (ip_host_order & kVipMask) == kVipNet;
+}
+bool IsBroadcast(uint32_t ip_host_order);
+
+// Starts the relay once (reads the cvars). Safe to call many times.
+void EnsureStarted();
+
+// Socket interception. Addresses/ports are host byte order.
+// Returns true when the packet was handled by the relay.
+bool SendTo(uint64_t native_socket, uint32_t dst_ip, uint16_t dst_port, const uint8_t* data,
+            uint32_t len);
+// Maps a loopback source (from an injector) back to the virtual sender.
+bool TranslateFrom(uint32_t& ip, uint16_t& port);
+
+// Fills a guest XNADDR (36 bytes) for a virtual address.
+void BuildXnAddr(uint32_t vip, uint8_t* xnaddr36);
+uint32_t VipFromXnAddr(const uint8_t* xnaddr36);
+
+// Session published by the host (XSESSION_INFO = 60 bytes) and QoS blob.
+void PublishSession(const uint8_t* info60, uint32_t public_slots, uint32_t private_slots);
+void ClearSession();
+bool GetSession(uint8_t* info60, uint32_t& public_slots, uint32_t& private_slots,
+                uint32_t& filled);
+void SetQosData(const uint8_t* data, uint32_t len);
+std::vector<uint8_t> GetQosData();
+
+}  // namespace rex::kernel::xam::netrelay
