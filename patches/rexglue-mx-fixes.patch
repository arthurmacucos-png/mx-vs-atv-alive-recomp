+bool PhysicalHeap::HandleReadProbe(uint32_t virtual_address) {
+  if (virtual_address < heap_base_) {
+    return false;
+  }
+  uint32_t heap_relative_address = virtual_address - heap_base_;
+  if (heap_relative_address >= heap_size_) {
+    return false;
+  }
+  uint32_t i = (heap_relative_address + host_address_offset()) / system_page_size_;
+  if (i >= system_page_count_) {
+    return false;
+  }
+  uint64_t bit = uint64_t(1) << (i & 63);
+  SystemPageFlagsBlock& block = system_page_flags_[i >> 6];
+  if (!(block.read_probe & bit)) {
+    return false;
+  }
+  block.read_probe &= ~bit;
+  // Restore what the page would have without the probe.
+  rex::memory::PageAccess restore = rex::memory::PageAccess::kReadWrite;
+  uint32_t guest_page_number =
+      rex::sat_sub(i * system_page_size_, host_address_offset()) >> page_size_shift_;
+  if (guest_page_number < page_table_.size()) {
+    restore = ToPageAccess(page_table_[guest_page_number].current_protect);
+  }
+  if ((block.notify_on_invalidation & bit) && restore == rex::memory::PageAccess::kReadWrite) {
+    restore = rex::memory::PageAccess::kReadOnly;
+  }
+  rex::memory::Protect(membase_ + heap_base_ + i * system_page_size_, system_page_size_, restore);
+  if (memory_->read_probe_callback_) {
+    uint32_t probe_physical = rex::sat_sub(i * system_page_size_, host_address_offset()) +
+                              GetPhysicalAddress(heap_base_);
+    memory_->read_probe_callback_(memory_->read_probe_context_, probe_physical,
+                                  system_page_size_);
+  }
+  return true;
+}
