+  const uint32_t image_start = 0x82000000;
+  uint32_t image_end = image_start, code_min = 0, code_max = 0;
+  for (uint32_t a = image_start; a < 0x8A000000;) {
+    uint32_t end = 0;
+    if (!readable(a, end)) break;
+    image_end = end;
+    a = end;
+  }
+  for (uint32_t a = image_start; a < image_end; a += 4) {
