+// Online relay: answers XSessionSearch with the session the host published.
+// XSESSION_SEARCHRESULT_HEADER { dwSearchResults, pResults } followed by
+// XSESSION_SEARCHRESULT { XSESSION_INFO[60], open pub, open priv, filled pub,
+// filled priv, cProperties, cContexts, pProperties, pContexts } (92 bytes).
+static void FillRelaySearch(rex::memory::Memory* memory, uint32_t results_ptr, uint32_t results_size) {
+  if (!results_ptr || results_size < 8) return;
+  uint8_t* hdr = memory->TranslateVirtual(results_ptr);
+  memory::store_and_swap<uint32_t>(hdr + 0, 0);
+  memory::store_and_swap<uint32_t>(hdr + 4, results_ptr + 8);
+  uint8_t info[60];
+  uint32_t pub = 0, priv = 0, filled = 0;
+  if (netrelay::IsHost() || !netrelay::GetSession(info, pub, priv, filled)) return;
+  if (results_size < 8 + 92) return;
+  uint8_t* r = hdr + 8;
+  std::memset(r, 0, 92);
+  std::memcpy(r, info, 60);
+  uint32_t open_pub = pub > filled ? pub - filled : 0;
+  memory::store_and_swap<uint32_t>(r + 60, open_pub);
+  memory::store_and_swap<uint32_t>(r + 64, priv);
+  memory::store_and_swap<uint32_t>(r + 68, filled);
+  memory::store_and_swap<uint32_t>(r + 72, 0);
+  memory::store_and_swap<uint32_t>(hdr + 0, 1);
+  REXKRNL_INFO("[net] busca de sessão: 1 encontrada ({} jogador(es))", filled);
+}
