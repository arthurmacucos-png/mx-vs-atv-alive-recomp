+    end = uint32_t((static_cast<uint8_t*>(mbi.BaseAddress) - base) + mbi.RegionSize);
+    return mbi.State == MEM_COMMIT && mbi.Protect && !(mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD));
+  };
