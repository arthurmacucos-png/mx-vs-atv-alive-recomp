+// Overlapped (asynchronous) datagram I/O: WSARecvFrom / WSASendTo /
+// WSAGetOverlappedResult / WSACancelOverlappedIO.
+//
+// The title posts a receive with an XWSAOVERLAPPED and later polls it or waits
+// on its event. A small poller thread completes pending receives when the
+// native socket becomes readable: it copies the datagram into the guest
+// buffers, stores status/bytes in the overlapped block and signals the event.
+// XWSAOVERLAPPED: +0 Internal (status), +4 InternalHigh (bytes), +16 hEvent.
+// ---------------------------------------------------------------------------
+namespace {
+constexpr uint32_t kStatusPending = 0x103;
+constexpr uint32_t kWsaIoPending = 997;
+constexpr uint32_t kWsaIoIncomplete = 996;
+constexpr uint32_t kWsaOperationAborted = 995;
+constexpr uint32_t kWsaEWouldBlock = 10035;
+
+struct GuestBuf {
+  uint32_t ptr;
+  uint32_t len;
+};
+
+struct PendingRecv {
+  uint32_t socket_handle;
+  SOCKET native;
+  std::vector<GuestBuf> bufs;
+  uint32_t bytes_ptr;
+  uint32_t from_ptr;
+  uint32_t fromlen_ptr;
+  uint32_t overlapped_ptr;
+};
+
+struct OverlappedIo {
+  std::mutex mutex;
+  std::condition_variable cv;
+  std::list<PendingRecv> pending;
+  bool started = false;
+};
+OverlappedIo& Ovl() {
+  static OverlappedIo o;
+  return o;
+}
+
+std::vector<GuestBuf> LoadBufs(uint32_t bufs_ptr, uint32_t count) {
+  std::vector<GuestBuf> v;
+  auto p = GuestPtr(bufs_ptr);
+  for (uint32_t i = 0; p && i < count && i < 16; i++) {
+    v.push_back({memory::load_and_swap<uint32_t>(p + i * 8 + 4),
+                 memory::load_and_swap<uint32_t>(p + i * 8)});
+  }
+  return v;
+}
+
+void FinishOverlapped(uint32_t overlapped_ptr, uint32_t status, uint32_t bytes) {
+  auto o = GuestPtr(overlapped_ptr);
+  if (!o) return;
+  memory::store_and_swap<uint32_t>(o + 4, bytes);
+  memory::store_and_swap<uint32_t>(o + 0, status);
+  SetEvent(memory::load_and_swap<uint32_t>(o + 16));
+}
+
+// Reads one datagram if one is waiting. Returns bytes, -1 = nothing yet,
+// -2 = socket error.
+int TryRecv(SOCKET native, const std::vector<GuestBuf>& bufs, uint32_t from_ptr,
+            uint32_t fromlen_ptr) {
+  fd_set rf;
+  FD_ZERO(&rf);
+  FD_SET(native, &rf);
+  timeval tv{0, 0};
+  int ready = select(0, &rf, nullptr, nullptr, &tv);
+  if (ready < 0) return -2;
+  if (ready == 0) return -1;
+  static thread_local std::vector<uint8_t> tmp(65536);
+  sockaddr_in from{};
+  int flen = sizeof(from);
+  int n = recvfrom(native, reinterpret_cast<char*>(tmp.data()), int(tmp.size()), 0,
+                   reinterpret_cast<sockaddr*>(&from), &flen);
+  if (n < 0) {
+    int err = WSAGetLastError();
+    // A UDP "port unreachable" from an earlier send is not fatal.
+    if (err == WSAEWOULDBLOCK || err == WSAECONNRESET) return -1;
+    return -2;
+  }
+  uint32_t off = 0;
+  for (auto& b : bufs) {
+    if (off >= uint32_t(n)) break;
+    uint32_t take = std::min<uint32_t>(b.len, uint32_t(n) - off);
+    if (auto g = GuestPtr(b.ptr)) std::memcpy(g, tmp.data() + off, take);
+    off += take;
+  }
+  uint32_t ip = ntohl(from.sin_addr.s_addr);
+  uint16_t port = ntohs(from.sin_port);
+  netrelay::TranslateFrom(ip, port);
+  if (from_ptr) StoreGuestAddr(from_ptr, fromlen_ptr, ip, port);
+  return int(off);
+}
+
+void OverlappedPoller() {
+  auto& o = Ovl();
+  for (;;) {
+    std::unique_lock<std::mutex> lock(o.mutex);
+    if (o.pending.empty()) {
+      o.cv.wait(lock);
+      continue;
+    }
+    for (auto it = o.pending.begin(); it != o.pending.end();) {
+      int n = TryRecv(it->native, it->bufs, it->from_ptr, it->fromlen_ptr);
+      if (n == -1) {
+        ++it;
+        continue;
+      }
+      if (n >= 0) {
+        if (auto b = GuestPtr(it->bytes_ptr)) memory::store_and_swap<uint32_t>(b, uint32_t(n));
+        FinishOverlapped(it->overlapped_ptr, 0, uint32_t(n));
+      } else {
+        FinishOverlapped(it->overlapped_ptr, 0xC0000120 /* STATUS_CANCELLED */, 0);
+      }
+      it = o.pending.erase(it);
+    }
+    lock.unlock();
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  }
+}
+
+void QueuePending(PendingRecv&& op) {
+  auto& o = Ovl();
+  std::lock_guard<std::mutex> lock(o.mutex);
+  // One receive per overlapped block.
+  for (auto it = o.pending.begin(); it != o.pending.end();) {
+    if (it->overlapped_ptr == op.overlapped_ptr)
+      it = o.pending.erase(it);
+    else
+      ++it;
+  }
+  o.pending.push_back(std::move(op));
+  if (!o.started) {
+    o.started = true;
+    std::thread(OverlappedPoller).detach();
+  }
+  o.cv.notify_one();
+}
