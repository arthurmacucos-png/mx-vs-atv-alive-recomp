+void PhysicalHeap::ArmReadProbe(uint32_t physical_address, uint32_t length) {
+  uint32_t physical_address_offset = GetPhysicalAddress(heap_base_);
+  if (physical_address < physical_address_offset) {
+    if (physical_address_offset - physical_address >= length) {
+      return;
+    }
+    length -= physical_address_offset - physical_address;
+    physical_address = physical_address_offset;
+  }
+  uint32_t heap_relative_address = physical_address - physical_address_offset;
+  if (heap_relative_address >= heap_size_) {
+    return;
+  }
+  length = std::min(length, heap_size_ - heap_relative_address);
+  if (length == 0) {
+    return;
+  }
+  uint32_t system_page_first = (heap_relative_address + host_address_offset()) / system_page_size_;
+  uint32_t system_page_last =
+      (heap_relative_address + length - 1 + host_address_offset()) / system_page_size_;
+  system_page_last = std::min(system_page_last, system_page_count_ - 1);
+
+  uint8_t* protect_base = membase_ + heap_base_;
+  uint32_t protect_first = UINT32_MAX;
+  auto global_lock = global_critical_region_.Acquire();
+  for (uint32_t i = system_page_first; i <= system_page_last + 1; ++i) {
+    bool protect_page = false;
+    if (i <= system_page_last) {
+      uint32_t guest_page_number =
+          rex::sat_sub(i * system_page_size_, host_address_offset()) >> page_size_shift_;
+      if (guest_page_number < page_table_.size() &&
+          ToPageAccess(page_table_[guest_page_number].current_protect) !=
+              rex::memory::PageAccess::kNoAccess) {
+        system_page_flags_[i >> 6].read_probe |= uint64_t(1) << (i & 63);
+        protect_page = true;
+      }
+    }
+    if (protect_page) {
+      if (protect_first == UINT32_MAX) {
+        protect_first = i;
+      }
+    } else if (protect_first != UINT32_MAX) {
+      rex::memory::Protect(protect_base + protect_first * system_page_size_,
+                           (i - protect_first) * system_page_size_,
+                           rex::memory::PageAccess::kNoAccess);
+      protect_first = UINT32_MAX;
+    }
+  }
+}
+
+bool PhysicalHeap::HandleReadProbe(uint32_t virtual_address) {
+  if (virtual_address < heap_base_) {
+    return false;
+  }
+  uint32_t heap_relative_address = virtual_address - heap_base_;
+  if (heap_relative_address >= heap_size_) {
+    return false;
+  }
+  uint32_t i = (heap_relative_address + host_address_offset()) / system_page_size_;
+  if (i >= system_page_count_) {
+    return false;
+  }
+  uint64_t bit = uint64_t(1) << (i & 63);
+  SystemPageFlagsBlock& block = system_page_flags_[i >> 6];
+  if (!(block.read_probe & bit)) {
+    return false;
+  }
+  block.read_probe &= ~bit;
+  // Restore what the page would have without the probe.
+  rex::memory::PageAccess restore = rex::memory::PageAccess::kReadWrite;
+  uint32_t guest_page_number =
+      rex::sat_sub(i * system_page_size_, host_address_offset()) >> page_size_shift_;
+  if (guest_page_number < page_table_.size()) {
+    restore = ToPageAccess(page_table_[guest_page_number].current_protect);
+  }
+  if ((block.notify_on_invalidation & bit) && restore == rex::memory::PageAccess::kReadWrite) {
+    restore = rex::memory::PageAccess::kReadOnly;
+  }
+  rex::memory::Protect(membase_ + heap_base_ + i * system_page_size_, system_page_size_, restore);
