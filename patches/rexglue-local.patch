+// Copies resolved render-target data from D3D12 readback buffers into guest
+// memory on a dedicated thread. Jobs are processed in submission order. Each
+// job is tracked by (resolve key, buffer index) so the command processor can
+// wait before reusing that buffer.
+class ReadbackCopyWorker {
+ public:
+  ReadbackCopyWorker() : thread_(&ReadbackCopyWorker::Run, this) {}
+  ~ReadbackCopyWorker() {
+    {
+      std::lock_guard lock(mutex_);
+      running_ = false;
+    }
+    job_available_.notify_all();
+    if (thread_.joinable()) {
+      thread_.join();
+    }
+  }
+
+  void Enqueue(uint64_t key, uint32_t index, void* destination, const void* source,
+               uint32_t length) {
+    {
+      std::lock_guard lock(mutex_);
+      ++in_flight_[std::make_pair(key, index)];
+      jobs_.push_back(Job{key, index, destination, source, length});
+    }
+    job_available_.notify_one();
+  }
+
+  // Waits until no queued or running copy reads (key, index).
+  void WaitForTarget(uint64_t key, uint32_t index) {
+    std::unique_lock lock(mutex_);
+    idle_.wait(lock, [this, key, index] {
+      const auto it = in_flight_.find(std::make_pair(key, index));
+      return it == in_flight_.end() || it->second == 0;
+    });
+  }
+
+  void WaitForIdle() {
+    std::unique_lock lock(mutex_);
+    idle_.wait(lock, [this] { return jobs_.empty() && in_flight_.empty(); });
+  }
+
+ private:
+  struct Job {
+    uint64_t key;
+    uint32_t index;
+    void* destination;
+    const void* source;
+    uint32_t length;
+  };
+
+  void Run() {
+    std::unique_lock lock(mutex_);
+    for (;;) {
+      job_available_.wait(lock, [this] { return !running_ || !jobs_.empty(); });
+      if (jobs_.empty()) {
+        if (!running_) {
+          return;
+        }
+        continue;
+      }
+      const Job job = jobs_.front();
+      jobs_.pop_front();
+      lock.unlock();
+      std::memcpy(job.destination, job.source, job.length);
+      lock.lock();
+      const auto it = in_flight_.find(std::make_pair(job.key, job.index));
+      if (it != in_flight_.end() && --it->second == 0) {
+        in_flight_.erase(it);
+      }
+      idle_.notify_all();
+    }
+  }
