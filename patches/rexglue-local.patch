+  std::mutex mutex_;
+  std::condition_variable job_available_;
+  std::condition_variable idle_;
+  std::deque<Job> jobs_;
+  std::map<std::pair<uint64_t, uint32_t>, uint32_t> in_flight_;
+  bool running_ = true;
+  std::thread thread_;
+};
